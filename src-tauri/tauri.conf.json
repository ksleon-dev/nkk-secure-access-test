{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NKK Secure Access",
  "version": "0.1.0",
  "identifier": "de.kronsolutions.nkksecureaccess",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "NKK Secure Access",
        "width": 420,
        "height": 640,
        "minWidth": 420,
        "minHeight": 640,
        "maxWidth": 420,
        "maxHeight": 640,
        "resizable": false,
        "fullscreen": false,
        "center": true,
        "transparent": false,
        "decorations": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "deb", "appimage", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/branding.json": "resources/branding.json",
      "resources/assets/nkk-logo.svg": "resources/assets/nkk-logo.svg",
      "bin/netbird-installer.exe": "resources/bin/netbird-installer.exe",
      "bin/setup.conf": "resources/bin/setup.conf"
    },
    "category": "Productivity",
    "shortDescription": "VPN Client für NKK Mitarbeiter",
    "longDescription": "Sicherer Zugriff auf das NKK Firmennetz über NetBird WireGuard.",
    "windows": {
      "nsis": {
        "installerHooks": "nsis/installer.nsh",
        "installMode": "perMachine",
        "languages": ["German"],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico"
      }
    }
  },
  "plugins": {}
}
